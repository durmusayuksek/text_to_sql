APP_NAME=Text to SQL App
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
OPENAI_API_KEY=
AGENT_MODE=mock
# QUERY_AGENT_MODE is still supported as a backward-compatible fallback.
QUERY_AGENT_MODE=
OPENAI_MODEL=gpt-4.1-mini
DEBUG_QUERY_RESULTS=false
RESPONSE_AGENT_MAX_SAMPLE_ROWS=5
ENABLE_ASK_EVENT_LOGGING=true
ASK_EVENT_LOG_PATH=logs/ask_events.jsonl
LOG_QUERY_RESULT_ROWS=false
